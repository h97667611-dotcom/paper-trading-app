# Copy this file to .env for local reference only.
# NEITHER key below is required for the endpoints this app currently calls
# (CoinGecko public "/api/v3" tier and the public DexScreener API both work
# unauthenticated, within their public rate limits). The variables exist so
# the app can be upgraded to authenticated tiers without code changes.
#
# If you add a key, it must be injected at build time via
# gradle.properties (kept out of git) or CI secrets - NEVER hardcode it in
# Kotlin source or commit a real .env file.

COINGECKO_API_KEY=
DEXSCREENER_API_KEY=
